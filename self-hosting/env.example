# Wechselplan – Konfiguration für selbst betriebene Installationen.
# Nach /srv/wechselplan/.env kopieren, ausfüllen, `chmod 600 .env`.
# Erklärungen: README.md im Repository. Zufallswerte: `openssl rand -base64 48`
# Werte NICHT in Anführungszeichen setzen.

# --- Stack ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=wechselplan
DATA_ROOT=/srv/wechselplan
HTTP_PORT=3000
# Update-Kanal (README, Abschnitt 5): stable = nur Releases (empfohlen).
APP_IMAGE=ghcr.io/htl-braunau-it/wechselplan:stable

# --- Datenbank (läuft im selben Stack) --------------------------------------
POSTGRES_USER=wechselplan
POSTGRES_DB=wechselplan
POSTGRES_PASSWORD=<zufallswert>

# --- App ----------------------------------------------------------------------
NEXTAUTH_URL=https://wechselplan.ihre-schule.at
# ACHTUNG: Darf nach dem ersten Start NIE geändert werden. Daraus wird auch der
# Schlüssel für verschlüsselt gespeicherte Passwörter abgeleitet. Gut sichern!
NEXTAUTH_SECRET=<zufallswert>

# --- Entra (README, Abschnitt 2) ------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TEACHER_GROUP_ID=
ENTRA_SUPER_ADMIN_OBJECT_ID=
ENTRA_SYNC_ENABLED=true
# Nur Startwert, kommagetrennt; danach im Admin-Bereich pflegen.
ENTRA_SYNC_CLASS_GROUP_IDS=
# Schützt den nächtlichen Abgleich (POST /api/sync/run).
SYNC_TRIGGER_SECRET=<zufallswert>
# Abgleich verweigern, wenn er mehr als 20 % der aktiven Einträge deaktivieren würde.
SYNC_MAX_DEACTIVATION_RATIO=0.2

# --- Notenmanagement (optional) ---------------------------------------------
# Nur setzen, wenn Ihre Schule das Notenmanagement-System nutzt. Leer lassen
# blendet die Notenübertragung aus; alles andere funktioniert unverändert.
# Beispiel: https://notenmanagement.ihre-schule.at/work/rest/
NOTENMANAGEMENT_BASE_URL=

# --- Optional -----------------------------------------------------------------
# E-Mail (README, Abschnitt 2.4)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_FROM=
GRAPH_MAIL_TO=
# Mobile App (README, Abschnitt 2.5)
AUTH_BEARER_ENABLED=false
ENTRA_API_AUDIENCE=
# Online-Shell-Anbindung; leer = aus
ONLINE_SHELL_API_SECRET=

# Nur beim allerersten Start auf true, danach wieder false.
RUN_DB_SEED=false

# Update-Skript: docker-compose.yaml automatisch zur Version passend halten.
# Auf false setzen, wenn Sie die Compose-Datei selbst angepasst haben.
WECHSELPLAN_SYNC_COMPOSE=true
