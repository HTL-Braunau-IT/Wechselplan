# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
NOTENMANAGEMENT_BASE_URL=
DATABASE_URL="postgres://postgres:<your_password>@localhost:5432/mydb"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<your_secret_key>

# ----------------------------------------------------------------------------
# Auth provider toggles (parallel rollout)
#   Set to "false" to disable a provider at runtime.
# ----------------------------------------------------------------------------
AUTH_LDAP_ENABLED=true
AUTH_MS_ENABLED=true

# ----------------------------------------------------------------------------
# LDAP (legacy, will be retired after Entra migration)
# ----------------------------------------------------------------------------
LDAP_URL=
LDAP_BASE_DN=
LDAP_USERNAME=
LDAP_PASSWORD=<your_ldap_password>
LDAP_STUDENTS_OU=OU=Schueler,DC=htl-braunau,DC=int
LDAP_TEACHERS_OU=OU=Lehrer,DC=htl-braunau,DC=int
LDAP_PASSWORD=<your_ldap_password>
LDAP_STUDENT_GROUPS=<comma_separated_student_groups>
LDAP_TEACHER_GROUPS=<comma_separated_teacher_groups>

# ----------------------------------------------------------------------------
# Entra / Microsoft 365 identity
#
# These values are required for Microsoft login + Graph sync.
# Do NOT put per-deployment runtime config (like which class groups to sync)
# here - those are managed in the database via the admin settings UI.
# ----------------------------------------------------------------------------

# Entra tenant (directory) ID
ENTRA_TENANT_ID=

# App registration client ID + secret used for login and Graph calls
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Single Entra security group whose members are treated as teachers.
# Everyone allowed to log in who is NOT in this group is treated as a student.
ENTRA_TEACHER_GROUP_ID=

# Entra Object ID of the single super admin.
# Only this user can grant/revoke the local additive admin role.
ENTRA_SUPER_ADMIN_OBJECT_ID=

# Enable/disable the directory sync worker.
# When disabled, auth still works but no student/class sync runs.
ENTRA_SYNC_ENABLED=false

# Default sync mode when DB settings are not yet configured.
# Allowed values: "hybrid" (nightly + manual) or "nightly_only".
# After Phase 2 settings UI is live, the DB value takes precedence.
ENTRA_SYNC_MODE=hybrid

# Optional bootstrap fallback for the synced class group IDs.
# Primary source is the DB (managed via admin settings UI).
# This env var is only used on first run if the DB has nothing configured.
# Comma-separated list of Entra group IDs.
ENTRA_SYNC_CLASS_GROUP_IDS=

# ----------------------------------------------------------------------------
# Legacy Azure AD variable names (kept for backwards compatibility during
# Phase 1 rollout; remove in Phase 6 LDAP/Azure cleanup).
# ----------------------------------------------------------------------------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
MS_STUDENT_GROUPS=
MS_TEACHER_GROUPS=

# ----------------------------------------------------------------------------
# Microsoft Graph (mail sending, unrelated to identity sync)
# ----------------------------------------------------------------------------
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_MAIL_FROM=
GRAPH_MAIL_TO=

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
GITHUB_TOKEN=

# Entitlements / license server (optional; server-side only, do not use NEXT_PUBLIC_)
# LICENSE_SERVER_URL= base URL of the entitlements server (e.g. https://license.example.com)
# LICENSE_KEY= secret license key for this deployment (sent to server to receive feature list)
# DISABLE_ENTITLEMENTS= when set (e.g. true or 1), all features enabled and no server calls (for local/dev)
LICENSE_SERVER_URL=
LICENSE_KEY=
DISABLE_ENTITLEMENTS=

# Master toggle for the Notenmanagement transfer integration (HTL-Braunau).
# Set to "true" to enable the "An Notenmanagement übertragen" button in
# /notensammler and the "Notenmanagement Eintrag Gruppe X" button in /noten.
# Anything else (unset, "false", empty) disables the feature deployment-wide,
# even when the license server has notenmgmt_htl enabled.
NOTENMANAGEMENT=
