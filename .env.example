# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
NOTENMANAGEMENT_BASE_URL=
DATABASE_URL="postgres://postgres:<your_password>@localhost:5432/mydb"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<your_secret_key>

# ----------------------------------------------------------------------------
# Entra / Microsoft 365 identity
#
# These values are required for Microsoft login + Graph sync.
# Do NOT put per-deployment runtime config (like which class groups to sync)
# here - those are managed in the database via the admin settings UI.
# ----------------------------------------------------------------------------

# Entra tenant (directory) ID
ENTRA_TENANT_ID=

# App registration client ID + secret used for login and Graph calls.
#
# Required Graph *application* permissions (admin consent granted):
#   User.Read.All         - read user profiles for teacher/student sync
#   GroupMember.Read.All  - resolve group membership at login and during sync
#
# No delegated Graph permissions are needed: login only requests the OIDC
# scopes (openid/profile/email) and group membership is resolved app-only.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Single Entra security group whose members are treated as teachers.
# Everyone allowed to log in who is NOT in this group is treated as a student.
ENTRA_TEACHER_GROUP_ID=

# Entra Object ID of the single super admin.
# Only this user can grant/revoke the local additive admin role.
ENTRA_SUPER_ADMIN_OBJECT_ID=

# Enable/disable the directory sync worker.
# When disabled, auth still works but no student/class sync runs.
ENTRA_SYNC_ENABLED=false

# Optional bootstrap fallback for the synced class group IDs.
# Primary source is the DB (managed via admin settings UI).
# This env var is only used on first run if the DB has nothing configured.
# It drives both sync scope and login eligibility for non-teachers.
# Comma-separated list of Entra group IDs.
ENTRA_SYNC_CLASS_GROUP_IDS=

# Shared secret required by POST /api/sync/run, the unattended entrypoint an
# external scheduler (cron, systemd timer, k8s CronJob) calls to run the
# nightly directory sync. Sent as the `x-sync-secret` header or as
# `Authorization: Bearer <secret>`. Leave empty to disable the endpoint.
SYNC_TRIGGER_SECRET=

# Refuse an unattended sync that would deactivate more than this share of the
# currently active rows, as a guard against a Graph hiccup emptying a class.
# Expressed as a fraction between 0 and 1; defaults to 0.2 (20%).
SYNC_MAX_DEACTIVATION_RATIO=0.2

# ----------------------------------------------------------------------------
# Microsoft Graph (mail sending, unrelated to identity sync)
#
# A SEPARATE app registration from ENTRA_* above: this one carries Mail.Send,
# not User.Read.All. Directory sync no longer falls back to these names.
# ----------------------------------------------------------------------------
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_MAIL_FROM=
GRAPH_MAIL_TO=

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
GITHUB_TOKEN=

# Entitlements / license server (optional; server-side only, do not use NEXT_PUBLIC_)
# LICENSE_SERVER_URL= base URL of the entitlements server (e.g. https://license.example.com)
# LICENSE_KEY= secret license key for this deployment (sent to server to receive feature list)
# DISABLE_ENTITLEMENTS= when set (e.g. true or 1), all features enabled and no server calls (for local/dev)
LICENSE_SERVER_URL=
LICENSE_KEY=
DISABLE_ENTITLEMENTS=

# ----------------------------------------------------------------------------
# Deployment only
#
# These are read by docker-compose.yaml, not by the application, so they are
# irrelevant for local `npm run dev`. They live in the host `.env` on
# htlsrv-wechselplan-01 (10.10.10.148) — see docs/DEPLOYMENT.md.
# ----------------------------------------------------------------------------

# Which stack this env file describes. Production and staging share one compose
# file and differ only in these four values.
# COMPOSE_PROJECT_NAME=wechselplan
# DATA_ROOT=/srv/wechselplan
# HTTP_PORT=3000
# APP_IMAGE=ghcr.io/htl-braunau-it/wechselplan:latest

# Credentials for the Postgres container in the same stack. DATABASE_URL is
# assembled from these by compose, so it is not set directly in production.
# POSTGRES_USER=wechselplan
# POSTGRES_PASSWORD=
# POSTGRES_DB=wechselplan

# Run prisma/seed.mjs (roles + school holidays) as part of the migrate job.
# Set true for the first rollout against an empty database, then back to false.
# RUN_DB_SEED=false
