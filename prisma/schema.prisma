generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id              Int               @id @default(autoincrement())
  firstName       String
  lastName        String
  classId         Int?
  groupId         Int?
  sitzplatz       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  username        String            @unique
  class           Class?            @relation(fields: [classId], references: [id])
  grades          Grade[]
  finalGrades     FinalGrade[]
  classMemberships ClassMembership[]

  @@index([firstName, lastName])
  @@index([groupId])
  @@index([classId])
}

model Teacher {
  id          Int                 @id @default(autoincrement())
  firstName   String
  lastName    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  username    String              @unique
  email       String?             @unique
  assignments TeacherAssignment[]
  headClasses Class[]             @relation("ClassHead")
  leadClasses Class[]             @relation("ClassLead")
  grades      Grade[]

  @@index([firstName, lastName])
}

model Class {
  id               Int                     @id @default(autoincrement())
  name             String                  @unique
  description      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  classHeadId      Int?
  classLeadId      Int?
  schedules        Schedule[]
  students         Student[]
  assignments      TeacherAssignment[]
  grades           Grade[]
  finalGrades      FinalGrade[]
  transfers        NotenmanagementTransfer[]
  classMemberships ClassMembership[]
  classHead        Teacher?                @relation("ClassHead", fields: [classHeadId], references: [id])
  classLead        Teacher?                @relation("ClassLead", fields: [classLeadId], references: [id])

  @@index([name])
}

model SchoolYear {
  id                 Int       @id @default(autoincrement())
  label              String    @unique // e.g. "2025/2026"
  startDate          DateTime
  endDate            DateTime
  semesterChangeDate DateTime  // day when first semester ends / second semester starts
  isCurrent          Boolean?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  schedules              Schedule[]
  teacherAssignments    TeacherAssignment[]
  grades                Grade[]
  finalGrades           FinalGrade[]
  notenmanagementTransfers NotenmanagementTransfer[]
  classMemberships      ClassMembership[]

  @@index([label])
}

model ClassMembership {
  id           Int        @id @default(autoincrement())
  studentId    Int
  classId      Int
  schoolYearId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYearId])
  @@index([studentId])
  @@index([classId])
  @@index([schoolYearId])
}

model Schedule {
  id                Int            @id @default(autoincrement())
  name              String
  description       String?
  startDate         DateTime
  endDate           DateTime
  selectedWeekday   Int
  scheduleData      Json?          // Deprecated: will be removed after migration
  additionalInfo    String?
  semesterPlanning  String?        // "first", "second", or null for full year
  classId           Int?
  schoolYearId      Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  class             Class?         @relation(fields: [classId], references: [id])
  schoolYear        SchoolYear     @relation(fields: [schoolYearId], references: [id])
  breakTimes        BreakTime[]    @relation("BreakTimeToSchedule")
  scheduleTimes     ScheduleTime[] @relation("ScheduleToScheduleTime")
  turns             ScheduleTurn[]

  @@index([classId])
  @@index([schoolYearId])
}

model ScheduleTurn {
  id                Int            @id @default(autoincrement())
  scheduleId        Int
  name              String         // e.g., "TURNUS 1"
  customLength      Int?           // Optional custom length for this turn
  order             Int             // Order of the turn within the schedule
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  schedule          Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weeks             ScheduleWeek[]
  holidays          ScheduleTurnHoliday[]

  @@unique([scheduleId, order])
  @@index([scheduleId])
}

model ScheduleWeek {
  id                Int            @id @default(autoincrement())
  turnId            Int
  date              String         // Date in format "dd.MM.yy"
  week              String         // Week number in format "KW##"
  isHoliday         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  turn              ScheduleTurn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([date])
}

model ScheduleTurnHoliday {
  id                Int            @id @default(autoincrement())
  turnId            Int
  holidayId         Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  turn              ScheduleTurn   @relation(fields: [turnId], references: [id], onDelete: Cascade)
  holiday           SchoolHoliday  @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([turnId, holidayId])
  @@index([turnId])
  @@index([holidayId])
}

model GroupAssignment {
  id        Int      @id @default(autoincrement())
  groupId   Int
  class     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([class, groupId])
  @@index([class])
}

model TeacherAssignment {
  id                Int             @id @default(autoincrement())
  classId           Int
  period            String
  groupId           Int
  teacherId         Int
  subjectId         Int
  learningContentId Int
  roomId            Int
  selectedWeekday   Int             @default(1)
  schoolYearId      Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  class             Class           @relation(fields: [classId], references: [id])
  learningContent   LearningContent @relation(fields: [learningContentId], references: [id])
  room              Room            @relation(fields: [roomId], references: [id])
  subject           Subject         @relation(fields: [subjectId], references: [id])
  teacher           Teacher         @relation(fields: [teacherId], references: [id])
  schoolYear        SchoolYear      @relation(fields: [schoolYearId], references: [id])

  @@unique([classId, period, groupId, schoolYearId])
  @@index([classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([learningContentId])
  @@index([roomId])
  @@index([schoolYearId])
}

model Room {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  capacity    Int?
  description String?
  isCustom    Boolean             @default(false) // True if created by user, false if from seed/import
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments TeacherAssignment[]

  @@index([name])
}

model Subject {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String?
  isCustom          Boolean             @default(false) // True if created by user, false if from seed/import
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  TeacherAssignment TeacherAssignment[]

  @@index([name])
}

model LearningContent {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String?
  isCustom          Boolean             @default(false) // True if created by user, false if from seed/import
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  TeacherAssignment TeacherAssignment[]

  @@index([name])
}

model SchoolHoliday {
  id        Int                   @id @default(autoincrement())
  name      String                @unique
  startDate DateTime
  endDate   DateTime
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  scheduleTurns ScheduleTurnHoliday[]
}

model ScheduleTime {
  id        Int        @id @default(autoincrement())
  startTime String
  endTime   String
  hours     Float
  period    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[] @relation("ScheduleToScheduleTime")

  @@unique([startTime, endTime, period])
}

model BreakTime {
  id        Int        @id @default(autoincrement())
  name      String
  startTime String
  endTime   String
  period    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[] @relation("BreakTimeToSchedule")

  @@unique([startTime, endTime, period])
}

model SchedulePDF {
  id        String   @id @default(cuid())
  classId   String   @unique
  pdfData   Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeacherRotation {
  id        Int      @id @default(autoincrement())
  classId   Int
  groupId   Int
  teacherId Int
  turnId    String
  period    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, groupId, turnId, period])
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userRoles   UserRole[]

  @@index([name])
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model SupportMessage {
  id         Int      @id @default(autoincrement())
  name       String
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  currentUri String?

  @@index([createdAt])
}

model Grade {
  id           Int         @id @default(autoincrement())
  studentId   Int
  teacherId   Int
  classId     Int
  semester    String       // 'first' or 'second'
  grade       Float?
  schoolYearId Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  student     Student      @relation(fields: [studentId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  schoolYear  SchoolYear   @relation(fields: [schoolYearId], references: [id])

  @@unique([studentId, teacherId, classId, semester, schoolYearId])
  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

model FinalGrade {
  id               Int         @id @default(autoincrement())
  studentId        Int
  classId          Int
  semester         String      // 'first' or 'second'
  grade            Float?
  conductNoteWish  String?     // Betragensnote (Wunsch): Sehr zufriedenstellend, etc.
  schoolYearId     Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  student      Student     @relation(fields: [studentId], references: [id])
  class        Class       @relation(fields: [classId], references: [id])
  schoolYear   SchoolYear  @relation(fields: [schoolYearId], references: [id])

  @@unique([studentId, classId, semester, schoolYearId])
  @@index([studentId])
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

model NotenmanagementTransfer {
  id            Int         @id @default(autoincrement())
  classId       Int
  groupId       Int?        // null = class-level transfer, set = group-level (Notenstand)
  semester      String      // 'first' or 'second'
  lfId          String
  schoolYearId  Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  class         Class       @relation(fields: [classId], references: [id])
  schoolYear    SchoolYear  @relation(fields: [schoolYearId], references: [id])

  @@unique([classId, groupId, semester, schoolYearId])
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

// Noten (daily grades) feature: weights, Lehrstoff per day, and per-student-per-day entries
model NotenWeightConfig {
  id                    Int   @id @default(autoincrement())
  teacherId             Int
  classId               Int
  groupId              Int
  schoolYearId          Int
  weightWiederholung    Int   @default(25) // percentage, sum with others = 100
  weightBericht         Int   @default(25)
  weightMitarbeit       Int   @default(25)
  weightPraktischeArbeit Int  @default(25)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([teacherId, classId, groupId, schoolYearId])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
}

model LehrstoffPerDay {
  id           Int      @id @default(autoincrement())
  teacherId    Int
  classId      Int
  groupId      Int
  schoolYearId Int
  date         DateTime @db.Date
  period       String   // 'AM' | 'PM'
  lehrstoff    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([teacherId, classId, groupId, schoolYearId, date, period])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
}

model NotenEntry {
  id                 Int      @id @default(autoincrement())
  studentId          Int
  teacherId          Int
  classId            Int
  groupId            Int
  schoolYearId       Int
  date               DateTime @db.Date
  period             String   // 'AM' | 'PM'
  attendance         String?  // Anwesend | Krank | Entschuldigt | Unentschuldigt
  wiederholung1      Float?
  wiederholung2      Float?
  bericht1           Float?
  bericht2           Float?
  mitarbeit1         Float?
  mitarbeit2         Float?
  praktischeArbeit1  Float?
  praktischeArbeit2  Float?
  notizen            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([studentId, teacherId, classId, groupId, schoolYearId, date, period])
  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
  @@index([date])
}