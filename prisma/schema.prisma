generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------- Shared enums (Phase 3b) ---------- */

/// Semester within a school year.
enum Semester {
  first
  second
}

/// AM/PM half-day periods.
enum DayPart {
  AM
  PM
}

/// Break-time slots: AM and PM mirror DayPart, LUNCH is a midday-only slot.
enum BreakPeriod {
  AM
  PM
  LUNCH
}

/// Attendance state for a single Noten entry.
enum AttendanceState {
  Anwesend
  Krank
  Entschuldigt
  Unentschuldigt
}

/// Mode used by the Entra/AD directory sync job.
enum SyncMode {
  hybrid
  nightly_only
}

/// Status of a synced student in our system.
enum StudentSyncStatus {
  active
  unassigned
}

/// Whether a schedule covers the full year or a single semester.
enum SemesterPlan {
  first
  second
}

/// Nachmittag two-week rhythm: odd/even index among included rotation weeks.
enum PmBiweeklyAnchor {
  A_ON_ODD_WEEKS
  A_ON_EVEN_WEEKS
}

/// PM lesson applies every week or only on Spur A / Spur B weeks (ignored for AM).
enum PmTrack {
  ALL
  A
  B
}

/// Source of truth preference when both manual and Office 365 photos exist.
enum PhotoSourcePriority {
  manual_first
  o365_first
}

/// Kind of LookupValue: distinguishes Subject / Learning Content / Room rows.
enum LookupKind {
  SUBJECT
  LEARNING_CONTENT
  ROOM
}

model Student {
  id              Int               @id @default(autoincrement())
  firstName       String
  lastName        String
  sitzplatz       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  username        String            @unique
  email           String?
  externalId      String?           @unique
  externalSource  String?
  isActive        Boolean           @default(true)
  deactivatedAt   DateTime?
  lastSyncedAt    DateTime?
  syncStatus      StudentSyncStatus?
  grades          Grade[]
  finalGrades     FinalGrade[]
  classMemberships ClassMembership[]
  weekdayGroups   StudentWeekdayGroup[]
  notenEntries    NotenEntry[]

  @@index([firstName, lastName])
  @@index([isActive])
}

model Teacher {
  id             Int                 @id @default(autoincrement())
  firstName      String
  lastName       String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  username       String              @unique
  email          String?             @unique
  externalId     String?             @unique
  externalSource String?
  isActive       Boolean             @default(true)
  deactivatedAt  DateTime?
  lastSyncedAt   DateTime?
  assignments    TeacherAssignment[]
  headYears      ClassYearStaff[]    @relation("ClassHeadYear")
  leadYears      ClassYearStaff[]    @relation("ClassLeadYear")
  grades         Grade[]
  notenWeightConfigs NotenWeightConfig[]
  lehrstoffPerDays   LehrstoffPerDay[]
  notenEntries       NotenEntry[]

  @@index([firstName, lastName])
  @@index([isActive])
}

model Class {
  id               Int                     @id @default(autoincrement())
  name             String                  @unique
  description      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  externalId       String?                 @unique
  externalSource   String?
  isActive         Boolean                 @default(true)
  deactivatedAt    DateTime?
  lastSyncedAt     DateTime?
  schedules        Schedule[]
  assignments      TeacherAssignment[]
  grades           Grade[]
  finalGrades      FinalGrade[]
  transfers        NotenmanagementTransfer[]
  classMemberships ClassMembership[]
  notenWeightConfigs NotenWeightConfig[]
  lehrstoffPerDays   LehrstoffPerDay[]
  notenEntries       NotenEntry[]
  yearStaff        ClassYearStaff[]

  @@index([name])
  @@index([isActive])
}

/// Per-school-year class head and class lead assignments.
/// Replaces the old global Class.classHeadId / Class.classLeadId columns so
/// staff can change between school years without losing history.
model ClassYearStaff {
  id           Int        @id @default(autoincrement())
  classId      Int
  schoolYearId Int
  classHeadId  Int?
  classLeadId  Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  classHead    Teacher?   @relation("ClassHeadYear", fields: [classHeadId], references: [id])
  classLead    Teacher?   @relation("ClassLeadYear", fields: [classLeadId], references: [id])

  @@unique([classId, schoolYearId])
  @@index([classId])
  @@index([schoolYearId])
  @@index([classHeadId])
  @@index([classLeadId])
}

model SchoolYear {
  id                 Int       @id @default(autoincrement())
  label              String    @unique // e.g. "2025/2026"
  startDate          DateTime
  endDate            DateTime
  semesterChangeDate DateTime  // day when first semester ends / second semester starts
  isCurrent          Boolean?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  schedules              Schedule[]
  teacherAssignments    TeacherAssignment[]
  grades                Grade[]
  finalGrades           FinalGrade[]
  notenmanagementTransfers NotenmanagementTransfer[]
  classMemberships      ClassMembership[]
  studentWeekdayGroups  StudentWeekdayGroup[]
  teacherRotations      TeacherRotation[]
  notenWeightConfigs    NotenWeightConfig[]
  lehrstoffPerDays      LehrstoffPerDay[]
  notenEntries          NotenEntry[]
  classYearStaff        ClassYearStaff[]

  @@index([label])
}

/// Per-weekday group membership for a student within a school year (Wechselplan).
model StudentWeekdayGroup {
  id           Int        @id @default(autoincrement())
  studentId    Int
  schoolYearId Int
  weekday      Int
  groupId      Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYearId, weekday])
  @@index([studentId])
  @@index([schoolYearId])
}

model ClassMembership {
  id           Int        @id @default(autoincrement())
  studentId    Int
  classId      Int
  schoolYearId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYearId])
  @@index([studentId])
  @@index([classId])
  @@index([schoolYearId])
}

model Schedule {
  id                Int            @id @default(autoincrement())
  name              String
  description       String?
  startDate         DateTime
  endDate           DateTime
  selectedWeekday   Int
  additionalInfo    String?
  semesterPlanning  SemesterPlan?  // null = full-year plan
  /// When set, NM weeks use alternating Spur A/B among included rotation weeks.
  pmBiweeklyAnchor  PmBiweeklyAnchor?
  classId           Int?
  schoolYearId      Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  class             Class?         @relation(fields: [classId], references: [id])
  schoolYear        SchoolYear     @relation(fields: [schoolYearId], references: [id])
  breakTimes        BreakTime[]    @relation("BreakTimeToSchedule")
  scheduleTimes     ScheduleTime[] @relation("ScheduleToScheduleTime")
  turns             ScheduleTurn[]

  @@index([classId])
  @@index([schoolYearId])
}

model ScheduleTurn {
  id                Int            @id @default(autoincrement())
  scheduleId        Int
  name              String         // e.g., "TURNUS 1"
  customLength      Int?           // Optional custom length for this turn
  order             Int             // Order of the turn within the schedule
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  schedule          Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weeks             ScheduleWeek[]
  holidays          ScheduleTurnHoliday[]
  teacherRotations  TeacherRotation[]

  @@unique([scheduleId, order])
  @@index([scheduleId])
}

model ScheduleWeek {
  id                Int            @id @default(autoincrement())
  turnId            Int
  date              DateTime       @db.Date
  week              Int            // ISO week number
  isHoliday         Boolean        @default(false)
  /// When false, this Wechseltermin is excluded (trip, sports week, etc.).
  includedInPlan    Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  turn              ScheduleTurn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([date])
}

model ScheduleTurnHoliday {
  id                Int            @id @default(autoincrement())
  turnId            Int
  holidayId         Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  turn              ScheduleTurn   @relation(fields: [turnId], references: [id], onDelete: Cascade)
  holiday           SchoolHoliday  @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([turnId, holidayId])
  @@index([turnId])
  @@index([holidayId])
}

model TeacherAssignment {
  id                Int             @id @default(autoincrement())
  classId           Int
  period            DayPart
  groupId           Int
  teacherId         Int
  subjectId         Int
  learningContentId Int
  roomId            Int
  selectedWeekday   Int             @default(1)
  schoolYearId      Int
  /// PM only: weekly or restricted to Spur A / B (ignored when period is AM).
  pmTrack           PmTrack         @default(ALL)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  class             Class           @relation(fields: [classId], references: [id])
  learningContent   LookupValue     @relation("TeacherAssignmentLearningContent", fields: [learningContentId], references: [id])
  room              LookupValue     @relation("TeacherAssignmentRoom", fields: [roomId], references: [id])
  subject           LookupValue     @relation("TeacherAssignmentSubject", fields: [subjectId], references: [id])
  teacher           Teacher         @relation(fields: [teacherId], references: [id])
  schoolYear        SchoolYear      @relation(fields: [schoolYearId], references: [id])

  @@unique([classId, period, groupId, schoolYearId, selectedWeekday])
  @@index([classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([learningContentId])
  @@index([roomId])
  @@index([schoolYearId])
}

/// Unified Subject / Learning Content / Room lookup table.
/// Replaces the legacy Room, Subject, and LearningContent models which were structurally identical.
model LookupValue {
  id          Int                 @id @default(autoincrement())
  kind        LookupKind
  name        String
  description String?
  capacity    Int?                // only meaningful for ROOM rows
  isCustom    Boolean             @default(false) // True if created by user, false if from seed/import
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  subjectAssignments         TeacherAssignment[] @relation("TeacherAssignmentSubject")
  learningContentAssignments TeacherAssignment[] @relation("TeacherAssignmentLearningContent")
  roomAssignments            TeacherAssignment[] @relation("TeacherAssignmentRoom")

  @@unique([kind, name])
  @@index([kind])
  @@index([name])
}

model SchoolHoliday {
  id        Int                   @id @default(autoincrement())
  name      String                @unique
  startDate DateTime
  endDate   DateTime
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  scheduleTurns ScheduleTurnHoliday[]
}

model ScheduleTime {
  id        Int        @id @default(autoincrement())
  startTime String
  endTime   String
  hours     Float
  period    DayPart
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[] @relation("ScheduleToScheduleTime")

  @@unique([startTime, endTime, period])
}

model BreakTime {
  id        Int        @id @default(autoincrement())
  name      String
  startTime String
  endTime   String
  period    BreakPeriod
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[] @relation("BreakTimeToSchedule")

  @@unique([startTime, endTime, period])
}

model TeacherRotation {
  id        Int      @id @default(autoincrement())
  classId   Int
  groupId   Int
  teacherId Int
  turnId    Int
  period    DayPart
  schoolYearId Int
  selectedWeekday Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])
  turn       ScheduleTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([classId, groupId, turnId, period, schoolYearId, selectedWeekday])
  @@index([teacherId, schoolYearId, selectedWeekday])
  @@index([classId, schoolYearId, selectedWeekday])
  @@index([turnId])
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userRoles   UserRole[]

  @@index([name])
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model SupportMessage {
  id         Int      @id @default(autoincrement())
  name       String
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  currentUri String?

  @@index([createdAt])
}

// Admin-editable runtime settings for the Entra directory sync.
// Treated as a singleton: only the row with id = 1 is used.
model DirectorySyncSettings {
  id                  Int       @id @default(1)
  syncedClassGroupIds String[]  @default([])
  syncMode            SyncMode  @default(hybrid)
  syncEnabled         Boolean   @default(false)
  studentPhotoSourcePriority PhotoSourcePriority @default(manual_first)
  teacherPhotoSourcePriority PhotoSourcePriority @default(manual_first)
  lastSyncAt          DateTime?
  lastSyncStatus      String?
  lastSyncSummary     Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Admin-editable limits for schedule creation (student groups per class).
// Singleton: only the row with id = 1 is used.
model GeneralSettings {
  id                     Int @id @default(1)
  maxStudentsPerGroup    Int @default(12)
  maxScheduleGroups      Int @default(4)
  maxSupportedStudents   Int @default(48)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Grade {
  id           Int         @id @default(autoincrement())
  studentId   Int
  teacherId   Int
  classId     Int
  semester    Semester
  grade       Float?
  schoolYearId Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  student     Student      @relation(fields: [studentId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  schoolYear  SchoolYear   @relation(fields: [schoolYearId], references: [id])

  @@unique([studentId, teacherId, classId, semester, schoolYearId])
  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

model FinalGrade {
  id               Int         @id @default(autoincrement())
  studentId        Int
  classId          Int
  semester         Semester
  grade            Float?
  conductNoteWish  String?     // Betragensnote (Wunsch): Sehr zufriedenstellend, etc.
  schoolYearId     Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  student      Student     @relation(fields: [studentId], references: [id])
  class        Class       @relation(fields: [classId], references: [id])
  schoolYear   SchoolYear  @relation(fields: [schoolYearId], references: [id])

  @@unique([studentId, classId, semester, schoolYearId])
  @@index([studentId])
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

model NotenmanagementTransfer {
  id            Int         @id @default(autoincrement())
  classId       Int
  groupId       Int?        // null = class-level transfer, set = group-level (Notenstand)
  semester      Semester
  lfId          String
  schoolYearId  Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  class         Class       @relation(fields: [classId], references: [id])
  schoolYear    SchoolYear  @relation(fields: [schoolYearId], references: [id])

  @@unique([classId, groupId, semester, schoolYearId])
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

// Noten (daily grades) feature: weights, Lehrstoff per day, and per-student-per-day entries
model NotenWeightConfig {
  id                    Int   @id @default(autoincrement())
  teacherId             Int
  classId               Int
  groupId              Int
  schoolYearId          Int
  weightWiederholung    Int   @default(25) // percentage, sum with others = 100
  weightBericht         Int   @default(25)
  weightMitarbeit       Int   @default(25)
  weightPraktischeArbeit Int  @default(25)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  teacher               Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class                 Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear            SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, groupId, schoolYearId])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
}

model LehrstoffPerDay {
  id           Int      @id @default(autoincrement())
  teacherId    Int
  classId      Int
  groupId      Int
  schoolYearId Int
  date         DateTime @db.Date
  period       DayPart
  lehrstoff    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, groupId, schoolYearId, date, period])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
}

model NotenEntry {
  id                 Int      @id @default(autoincrement())
  studentId          Int
  teacherId          Int
  classId            Int
  groupId            Int
  schoolYearId       Int
  date               DateTime @db.Date
  period             DayPart
  attendance         AttendanceState?
  wiederholung1      Float?
  wiederholung2      Float?
  bericht1           Float?
  bericht2           Float?
  mitarbeit1         Float?
  mitarbeit2         Float?
  praktischeArbeit1  Float?
  praktischeArbeit2  Float?
  notizen            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  student            Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher            Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class              Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear         SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId, classId, groupId, schoolYearId, date, period])
  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
  @@index([date])
}