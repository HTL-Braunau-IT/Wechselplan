generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id               Int               @id @default(autoincrement())
  firstName        String
  lastName         String
  classId          Int?
  groupId          Int?
  sitzplatz        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  username         String            @unique
  email            String?
  externalId       String?           @unique
  externalSource   String?
  // Sokrates person id. In Entra this is the Graph `employeeId`; in
  // Notenmanagement it is the `Student_ID`. Same value in both systems, so it is
  // the deterministic key that links a student to their NM Matrikelnummer
  // without any name/class matching. Captured by the directory sync.
  sokratesId       String?           @unique
  // Notenmanagement identity, resolved by the NM link sync (matching sokratesId
  // against NM `Student_ID`). Cached so grade transfer never re-matches by name.
  matrikelnummer   String?
  nmKlasse         String? // real NM class name for this student (LF Klasse)
  nmLinkedAt       DateTime? // when matrikelnummer was last confirmed against NM
  isActive         Boolean           @default(true)
  deactivatedAt    DateTime?
  lastSyncedAt     DateTime?
  syncStatus       String? // "active" | "unassigned" (ambiguous membership)
  class            Class?            @relation(fields: [classId], references: [id])
  grades           Grade[]
  finalGrades      FinalGrade[]
  classMemberships ClassMembership[]

  @@index([firstName, lastName])
  @@index([groupId])
  @@index([classId])
  @@index([isActive])
  @@index([matrikelnummer])
}

model Teacher {
  id               Int                 @id @default(autoincrement())
  firstName        String
  lastName         String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  username         String              @unique
  email            String?             @unique
  externalId       String?             @unique
  externalSource   String?
  isActive         Boolean             @default(true)
  deactivatedAt    DateTime?
  lastSyncedAt     DateTime?
  assignments      TeacherAssignment[]
  headClasses      Class[]             @relation("ClassHead")
  leadClasses      Class[]             @relation("ClassLead")
  grades           Grade[]
  notifications    Notification[]      @relation("NotificationRecipient")
  createdSchedules Schedule[]          @relation("ScheduleCreator")

  @@index([firstName, lastName])
  @@index([isActive])
}

model Class {
  id               Int                       @id @default(autoincrement())
  name             String                    @unique
  description      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  classHeadId      Int?
  classLeadId      Int?
  externalId       String?                   @unique
  externalSource   String?
  isActive         Boolean                   @default(true)
  deactivatedAt    DateTime?
  lastSyncedAt     DateTime?
  schedules        Schedule[]
  students         Student[]
  assignments      TeacherAssignment[]
  grades           Grade[]
  finalGrades      FinalGrade[]
  transfers        NotenmanagementTransfer[]
  classMemberships ClassMembership[]
  classHead        Teacher?                  @relation("ClassHead", fields: [classHeadId], references: [id])
  classLead        Teacher?                  @relation("ClassLead", fields: [classLeadId], references: [id])

  @@index([name])
  @@index([isActive])
}

model SchoolYear {
  id                       Int                       @id @default(autoincrement())
  label                    String                    @unique // e.g. "2025/2026"
  startDate                DateTime
  endDate                  DateTime
  semesterChangeDate       DateTime // day when first semester ends / second semester starts
  isCurrent                Boolean?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  schedules                Schedule[]
  teacherAssignments       TeacherAssignment[]
  grades                   Grade[]
  finalGrades              FinalGrade[]
  notenmanagementTransfers NotenmanagementTransfer[]
  classMemberships         ClassMembership[]

  @@index([label])
}

model ClassMembership {
  id           Int        @id @default(autoincrement())
  studentId    Int
  classId      Int
  schoolYearId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYearId])
  @@index([studentId])
  @@index([classId])
  @@index([schoolYearId])
}

model Schedule {
  id               Int            @id @default(autoincrement())
  name             String
  description      String?
  startDate        DateTime
  endDate          DateTime
  selectedWeekday  Int
  // Per-period lane config. AM and PM are independent: each may be enabled on
  // its own and carries its own cadence. weekInterval 1 = every week, 2 = every
  // 2nd week; weekOffset 0 = starts on the A-week, 1 = starts on the B-week.
  // Turnus structure lives on ScheduleTurn.period, so counts can differ per lane.
  amEnabled        Boolean        @default(true)
  pmEnabled        Boolean        @default(true)
  amWeekInterval   Int            @default(1)
  amWeekOffset     Int            @default(0)
  pmWeekInterval   Int            @default(1)
  pmWeekOffset     Int            @default(0)
  scheduleData     Json? // Deprecated: null on all rows, kept for legacy read paths
  additionalInfo   String?
  semesterPlanning String? // "first", "second", or null for full year
  classId          Int?
  schoolYearId     Int
  // Teacher who first created this plan. Kept across later edits so the author
  // is notified about changes someone else makes (see src/lib/notifications.ts).
  createdById      Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  class            Class?         @relation(fields: [classId], references: [id])
  schoolYear       SchoolYear     @relation(fields: [schoolYearId], references: [id])
  createdBy        Teacher?       @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  breakTimes       BreakTime[]    @relation("BreakTimeToSchedule")
  scheduleTimes    ScheduleTime[] @relation("ScheduleToScheduleTime")
  turns            ScheduleTurn[]

  @@index([classId])
  @@index([schoolYearId])
  @@index([createdById])
}

model ScheduleTurn {
  id           Int                   @id @default(autoincrement())
  scheduleId   Int
  period       String                @default("AM") // "AM" | "PM" — which lane this Turnus belongs to
  name         String // e.g., "TURNUS 1"
  customLength Int? // Optional custom length for this turn
  order        Int // Order of the turn within its period lane
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  schedule     Schedule              @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weeks        ScheduleWeek[]
  holidays     ScheduleTurnHoliday[]

  @@unique([scheduleId, period, order])
  @@index([scheduleId])
}

model ScheduleWeek {
  id        Int          @id @default(autoincrement())
  turnId    Int
  date      String // Date in format "dd.MM.yy"
  week      String // Week number in format "KW##"
  isHoliday Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  turn      ScheduleTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([date])
}

model ScheduleTurnHoliday {
  id        Int           @id @default(autoincrement())
  turnId    Int
  holidayId Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  turn      ScheduleTurn  @relation(fields: [turnId], references: [id], onDelete: Cascade)
  holiday   SchoolHoliday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([turnId, holidayId])
  @@index([turnId])
  @@index([holidayId])
}

model GroupAssignment {
  id        Int      @id @default(autoincrement())
  groupId   Int
  class     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([class, groupId])
  @@index([class])
}

model TeacherAssignment {
  id                Int             @id @default(autoincrement())
  classId           Int
  period            String
  groupId           Int
  teacherId         Int
  subjectId         Int
  learningContentId Int
  roomId            Int
  selectedWeekday   Int             @default(1)
  schoolYearId      Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  class             Class           @relation(fields: [classId], references: [id])
  learningContent   LearningContent @relation(fields: [learningContentId], references: [id])
  room              Room            @relation(fields: [roomId], references: [id])
  subject           Subject         @relation(fields: [subjectId], references: [id])
  teacher           Teacher         @relation(fields: [teacherId], references: [id])
  schoolYear        SchoolYear      @relation(fields: [schoolYearId], references: [id])

  @@unique([classId, period, groupId, schoolYearId, selectedWeekday])
  @@index([classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([learningContentId])
  @@index([roomId])
  @@index([schoolYearId])
}

model Room {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  capacity    Int?
  description String?
  isCustom    Boolean             @default(false) // True if created by user, false if from seed/import
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments TeacherAssignment[]

  @@index([name])
}

model Subject {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String?
  isCustom          Boolean             @default(false) // True if created by user, false if from seed/import
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  TeacherAssignment TeacherAssignment[]

  @@index([name])
}

model LearningContent {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String?
  isCustom          Boolean             @default(false) // True if created by user, false if from seed/import
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  TeacherAssignment TeacherAssignment[]

  @@index([name])
}

model SchoolHoliday {
  id            Int                   @id @default(autoincrement())
  name          String                @unique
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  scheduleTurns ScheduleTurnHoliday[]
}

model ScheduleTime {
  id        Int        @id @default(autoincrement())
  startTime String
  endTime   String
  hours     Float
  period    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[] @relation("ScheduleToScheduleTime")

  @@unique([startTime, endTime, period])
}

model BreakTime {
  id        Int        @id @default(autoincrement())
  name      String
  startTime String
  endTime   String
  period    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[] @relation("BreakTimeToSchedule")

  @@unique([startTime, endTime, period])
}

model SchedulePDF {
  id        String   @id @default(cuid())
  classId   String   @unique
  pdfData   Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeacherRotation {
  id              Int      @id @default(autoincrement())
  classId         Int
  groupId         Int
  teacherId       Int
  turnId          String
  period          String
  selectedWeekday Int      @default(1)
  schoolYearId    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([classId, groupId, turnId, period, selectedWeekday, schoolYearId])
  @@index([classId])
  @@index([schoolYearId])
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userRoles   UserRole[]

  @@index([name])
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model SupportMessage {
  id         Int      @id @default(autoincrement())
  name       String
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  currentUri String?

  @@index([createdAt])
}

// Admin-editable runtime settings for the Entra directory sync.
// Treated as a singleton: only the row with id = 1 is used.
model DirectorySyncSettings {
  id                         Int       @id @default(1)
  syncedClassGroupIds        String[]  @default([])
  syncEnabled                Boolean   @default(false)
  studentPhotoSourcePriority String    @default("manual_first")
  teacherPhotoSourcePriority String    @default("manual_first")
  lastSyncAt                 DateTime?
  lastSyncStatus             String?
  lastSyncSummary            Json?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

// Admin-editable Notenmanagement integration settings. Singleton (id = 1).
// Holds the service Lehrer account used for the unattended Matrikelnummer link
// sync (reading /api/Schueler). The password is stored AES-256-GCM encrypted
// (see src/lib/crypto.ts) — never in plaintext. The actual grade transfer still
// authenticates as the individual teacher, so their credentials are never stored.
model NotenmanagementSettings {
  id                  Int       @id @default(1)
  serviceUsername     String?
  servicePasswordEnc  String? // AES-256-GCM ciphertext (base64: iv|tag|data)
  lastLinkSyncAt      DateTime?
  lastLinkSyncStatus  String?
  lastLinkSyncSummary Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Grade {
  id           Int        @id @default(autoincrement())
  studentId    Int
  teacherId    Int
  classId      Int
  semester     String // 'first' or 'second'
  grade        Float?
  schoolYearId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      Student    @relation(fields: [studentId], references: [id])
  teacher      Teacher    @relation(fields: [teacherId], references: [id])
  class        Class      @relation(fields: [classId], references: [id])
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  @@unique([studentId, teacherId, classId, semester, schoolYearId])
  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

model FinalGrade {
  id              Int        @id @default(autoincrement())
  studentId       Int
  classId         Int
  semester        String // 'first' or 'second'
  grade           Float?
  conductNoteWish String? // Betragensnote (Wunsch): Sehr zufriedenstellend, etc.
  schoolYearId    Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  student         Student    @relation(fields: [studentId], references: [id])
  class           Class      @relation(fields: [classId], references: [id])
  schoolYear      SchoolYear @relation(fields: [schoolYearId], references: [id])

  @@unique([studentId, classId, semester, schoolYearId])
  @@index([studentId])
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

model NotenmanagementTransfer {
  id           Int        @id @default(autoincrement())
  classId      Int
  groupId      Int? // null = class-level transfer, set = group-level (Notenstand)
  semester     String // 'first' or 'second'
  lfId         String
  nmKlasse     String? // real Notenmanagement class this LF was filed under; combined Wechselplan classes split into one LF (and record) per real class
  schoolYearId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  class        Class      @relation(fields: [classId], references: [id])
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  @@unique([classId, groupId, semester, schoolYearId, nmKlasse], map: "NotenmanagementTransfer_split_key")
  @@index([classId])
  @@index([semester])
  @@index([schoolYearId])
}

// Noten (daily grades) feature: weights, Lehrstoff per day, and per-student-per-day entries
model NotenWeightConfig {
  id                     Int      @id @default(autoincrement())
  teacherId              Int
  classId                Int
  groupId                Int
  schoolYearId           Int
  weightWiederholung     Int      @default(25) // percentage, sum with others = 100
  weightBericht          Int      @default(25)
  weightMitarbeit        Int      @default(25)
  weightPraktischeArbeit Int      @default(25)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([teacherId, classId, groupId, schoolYearId])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
}

model LehrstoffPerDay {
  id           Int      @id @default(autoincrement())
  teacherId    Int
  classId      Int
  groupId      Int
  schoolYearId Int
  date         DateTime @db.Date
  period       String // 'AM' | 'PM'
  lehrstoff    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([teacherId, classId, groupId, schoolYearId, date, period])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
}

model NotenEntry {
  id                Int      @id @default(autoincrement())
  studentId         Int
  teacherId         Int
  classId           Int
  groupId           Int
  schoolYearId      Int
  date              DateTime @db.Date
  period            String // 'AM' | 'PM'
  attendance        String? // Anwesend | Krank | Entschuldigt | Unentschuldigt
  wiederholung1     Float?
  wiederholung2     Float?
  bericht1          Float?
  bericht2          Float?
  mitarbeit1        Float?
  mitarbeit2        Float?
  praktischeArbeit1 Float?
  praktischeArbeit2 Float?
  notizen           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([studentId, teacherId, classId, groupId, schoolYearId, date, period])
  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolYearId])
  @@index([date])
}

// Sokrates transfer marker + edit lock.
//
// Wechselplan cannot write to Sokrates (the government Zeugnis system has no
// API — grades are typed in by hand), so the Klassenvorstand records HERE that
// a class+semester has been entered into Sokrates. Once marked, later grade
// changes by subject teachers are either blocked (hard lock) or allowed and
// reported to the class lead (soft mark) — see src/lib/sokrates-lock.ts.
model SokratesTransfer {
  id           Int      @id @default(autoincrement())
  classId      Int
  semester     String // 'first' | 'second'
  schoolYearId Int
  markedById   Int // Teacher (class lead or admin) who marked it entered
  markedByName String
  markedAt     DateTime @default(now())
  lockedAll    Boolean  @default(false) // hard-lock the whole class (hybrid escalation)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjectLocks SokratesSubjectLock[]
  notices      SokratesChangeNotice[]

  @@unique([classId, semester, schoolYearId])
  @@index([classId, schoolYearId])
}

// A single hard-locked teacher/subject column under a SokratesTransfer (hybrid:
// the class lead can escalate one column rather than the whole class).
model SokratesSubjectLock {
  id         Int      @id @default(autoincrement())
  transferId Int
  teacherId  Int
  createdAt  DateTime @default(now())

  transfer SokratesTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, teacherId])
}

// Audit + notification record: one row per grade changed AFTER its class+semester
// was marked as entered into Sokrates. Drives the in-app notification bell and is
// the source for the email sent to the class lead. Names are point-in-time
// snapshots so the record stays readable even if people are later renamed.
model SokratesChangeNotice {
  id                 Int       @id @default(autoincrement())
  transferId         Int
  classId            Int
  className          String
  semester           String
  schoolYearId       Int
  studentId          Int
  studentName        String
  teacherId          Int // subject/teacher column that changed
  subjectTeacherName String
  oldGrade           Float?
  newGrade           Float?
  changedById        Int? // teacher who made the change (null: admin without a Teacher row)
  changedByName      String
  recipientId        Int? // class lead notified (null if the class has no lead)
  changedAt          DateTime  @default(now())
  acknowledgedAt     DateTime?

  transfer SokratesTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([classId, schoolYearId])
  @@index([recipientId, acknowledgedAt])
}

// One in-app notification addressed to one teacher, rendered by the bell in the
// top bar. Deliberately generic: the domain tables above stay the record of
// what happened, this one is only the delivery channel.
//
// `type` selects the i18next message and `params` supplies its interpolation
// values, so a notification written today still renders in both languages —
// see NOTIFICATION_TYPES in src/lib/notifications.ts, which is the contract
// between the writer and src/components/notification-bell.tsx.
model Notification {
  id          Int       @id @default(autoincrement())
  recipientId Int
  type        String
  params      Json      @default("{}")
  /// In-app path opened when the row is clicked, e.g. "/notensammler?class=1AHIT".
  link        String?
  /// Teacher who triggered it; null when an admin without a Teacher row did.
  actorId     Int?
  /// Point-in-time snapshot, so the row stays readable after a rename.
  actorName   String
  /// Collapse key. An unread row with the same recipient+type+key is refreshed
  /// rather than duplicated, so saving a grade sheet fifty times still leaves
  /// the class lead with a single entry.
  dedupeKey   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  readAt      DateTime?
  /// Set once this row has been rolled into a sent e-mail digest, so the daily
  /// digest run never mails the same missed notification twice. Null means it is
  /// still eligible for the next digest (if it stays unread past the threshold).
  digestedAt  DateTime?

  recipient Teacher @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([dedupeKey, readAt])
  /// Serves the digest sweep: unread, not-yet-digested rows older than the cutoff.
  @@index([readAt, digestedAt, createdAt])
}

// Admin-editable notification settings. Singleton (id = 1). Currently just the
// master switch for the daily e-mail digest of unacknowledged notifications
// (issue #96): a teacher who leaves new bell entries unread past
// DIGEST_AGE_HOURS gets one plain summary mail, but only while this is on.
model NotificationSettings {
  id                 Int       @id @default(1)
  /// Master switch for the unacknowledged-notification e-mail digest.
  emailDigestEnabled Boolean   @default(false)
  lastDigestRunAt    DateTime?
  lastDigestStatus   String?
  lastDigestSummary  Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Captured application error, surfaced to admins in the in-app Fehlerprotokoll
// (Admin → error log) so they never need a shell on the host to see what broke.
//
// Written best-effort by `captureError` (server) and the `/api/client-errors`
// ingest (browser); a write that fails must never break the request it is
// reporting on. Repeats collapse onto one row by `dedupeKey`
// (hash of location + type + message), bumping `count` and `lastSeenAt` rather
// than inserting again — the same trick the notification bell uses. Rows are
// pruned by an age-based job (see src/lib/error-log.ts). `context` is redacted
// at the call site: never raw request bodies, grades, or PII.
model ErrorLog {
  id             Int       @id @default(autoincrement())
  source         String    @default("server") // "server" | "client"
  level          String    @default("error") // "error" | "warn"
  location       String // logical origin, e.g. "api/noten/data"
  type           String // operation kind, e.g. "fetch-data"
  message        String
  stack          String?
  context        Json? // redacted structured extra
  path           String? // request path, when known
  method         String? // HTTP method, when known
  actorId        Int? // Teacher who hit it, when resolvable
  actorName      String?
  // Unique so `recordError` can collapse repeats with one atomic upsert rather
  // than a racy findFirst→create (concurrent hits would otherwise each insert).
  dedupeKey      String    @unique // hash(location + type + message)
  count          Int       @default(1)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([lastSeenAt])
  @@index([location])
  @@index([acknowledgedAt, lastSeenAt])
}
